# ---------------------------------------------------------------- gizli bilgiler
# .env TURETILMIS dosyalari da kapsa: .env.bak / .env.broken / .env.local gibi
# yedekler gercek API anahtarlarini icerir ve kazara commit edilebilir.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
client_secret*.json
token.json
*oauth*token*.json
.streamlit/secrets.toml

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# sanal ortamlar
.venv/
venv/
env/
ENV/
.conda/

# paketleme / derleme ciktilari
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

