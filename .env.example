GEMINI_API_KEY=
# Kullanilamiyorsa gemini-3.7-flash / gemini-flash-latest / gemini-2.5-flash
# sirasiyla denenir (Google eski modelleri yeni projelere kapatabiliyor).
GEMINI_MODEL=gemini-3.7-flash
# -1 = ayari hic gonderme (varsayilan, en uyumlu). 0 = "thinking" kapali.
# Bazi modeller bu parametreyi hic kabul etmiyor; kod otomatik olarak parametresiz tekrar dener.
GEMINI_THINKING_BUDGET=-1

# Primary discovery path. Leave blank to use yt-dlp fallback only.
YOUTUBE_DATA_API_KEY=

# Optional official playlist creation (API anahtari GEREKMEZ, sadece OAuth).
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_TOKEN_FILE=data/cache/youtube_oauth_token.json
# Uzak/headless sunucuda false yapin: tarayici acan yerel OAuth sunucusu calismaz.
YOUTUBE_OAUTH_ALLOW_LOCAL_SERVER=true
# private | unlisted | public
YOUTUBE_PLAYLIST_PRIVACY_STATUS=private

# ASR backend selection: auto | faster-whisper | whisper.cpp
ASR_BACKEND=auto
FASTER_WHISPER_MODEL_SIZE=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=1
ALLOW_UNSAFE_OPENMP_WORKAROUND=true
WHISPER_CPP_CLI_PATH=whisper.cpp/build/bin/whisper-cli.exe
WHISPER_CPP_MODEL_PATH=whisper.cpp/models/ggml-base.bin
WHISPER_CPP_TIMEOUT_SEC=1800

# Optional if ffmpeg is not on PATH
FFMPEG_PATH=
YTDLP_PROXY=
# YouTube "429 Too Many Requests" / IP blogu veriyorsa: tarayicinizin cerezlerini
# kullanmak istekleri kimliklendirir ve sinirlari belirgin sekilde gevsetir.
# Ornek: chrome | firefox | edge | chrome:Profile 1
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_JS_RUNTIME=node

DATA_DIR=data
SQLITE_PATH=data/cache/app.db

# Pipeline boyutlandirma
# Ana dil Ingilizce degilken, ek olarak Ingilizce arama da yapilsin mi
# (arayuzdeki anahtarin varsayilani). Alt konu basina +100 YouTube kota birimi.
INCLUDE_ENGLISH_BY_DEFAULT=true
MAX_SUBTOPICS=6
SEARCH_CANDIDATES_PER_SUBTOPIC=12
METADATA_TOP_K=4
# Kac aday icin transkript cekilecek (metadata_top_k'yi asamaz)
TRANSCRIPT_ENRICHMENT_TOP_K=2
# ASR (ses indir + Whisper) acik ara en pahali adim: video basina ~90-120 sn.
# Varsayilan KAPALI; arayuzdeki anahtardan veya buradan acilabilir.
ENABLE_ASR_FALLBACK=false
MAX_ASR_VIDEOS_PER_RUN=2

# Paralellik
MAX_SEARCH_WORKERS=4
MAX_TRANSCRIPT_WORKERS=4

REQUEST_TIMEOUT_SEC=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SEC=1.0

# Onbellek ve saglayici sagligi (saniye)
SEARCH_CACHE_TTL_SEC=21600
TRANSCRIPT_CACHE_TTL_SEC=2592000
FAILURE_CACHE_TTL_SEC=900
PROVIDER_COOLDOWN_SEC=900
# Bir saglayici kac ardisik hatadan sonra cooldown'a alinsin
PROVIDER_FAILURE_THRESHOLD=3
# HTTP 429 / IP blogu icin ayri (daha uzun) dinlenme. Hiz siniri hatalari
# TEKRAR DENENMEZ; tekrar denemek YouTube nezdinde blogu derinlestirir.
RATE_LIMIT_COOLDOWN_SEC=1800
